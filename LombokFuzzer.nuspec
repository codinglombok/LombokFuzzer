<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>codinglombok.LombokFuzzer</id>
    <version>$version$</version>
    <authors>codinglombok</authors>
    <description>Universal fuzzing framework — dist JS content package. Part of the Lombok Ecosystem.</description>
    <license type="expression">Apache-2.0</license>
    <projectUrl>https://github.com/codinglombok/LombokFuzzer</projectUrl>
    <repository type="git" url="https://github.com/codinglombok/LombokFuzzer.git" />
    <tags>fuzzing security testing lombokfuzzer</tags>
  </metadata>
  <files>
    <file src="dist/**" target="content/dist" />
    <file src="README.md" target="content/" />
    <file src="LICENSE" target="content/" />
  </files>
</package>

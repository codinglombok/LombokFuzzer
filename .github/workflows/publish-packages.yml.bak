name: Publish GitHub Packages (all registries)

on:
  release:
    types: [published]

jobs:
  build:
    name: Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      - name: Test
        run: npm test

      - name: Upload dist artifact
        uses: actions/upload-artifact@v4
        with:
          name: dist
          path: dist/
          retention-days: 1

  # ── npm (GitHub Packages) ─────────────────────────────────────────────────
  npm:
    name: npm (GitHub Packages)
    needs: build
    runs-on: ubuntu-latest
    permissions:
      packages: write
      contents: read

    steps:
      - uses: actions/checkout@v4

      - name: Download dist artifact
        uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist/

      - name: Setup Node.js (GitHub Packages registry)
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          registry-url: 'https://npm.pkg.github.com'

      - name: Publish to GitHub Packages (npm)
        run: npm publish --access public --ignore-scripts --registry https://npm.pkg.github.com/
        env:
          NODE_AUTH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  # ── Container (ghcr.io) ──────────────────────────────────────────────────
  container:
    name: Container (ghcr.io)
    needs: build
    runs-on: ubuntu-latest
    permissions:
      packages: write
      contents: read

    steps:
      - uses: actions/checkout@v4

      - name: Login to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push Docker image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: |
            ghcr.io/${{ github.repository_owner }}/lombokfuzzer:latest
            ghcr.io/${{ github.repository_owner }}/lombokfuzzer:${{ github.ref_name }}

  # ── Maven (webjar) ────────────────────────────────────────────────────────
  maven:
    name: Maven (webjar)
    needs: build
    runs-on: ubuntu-latest
    permissions:
      packages: write
      contents: read

    steps:
      - uses: actions/checkout@v4

      - name: Download dist artifact
        uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist/

      - uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Set version from tag
        run: echo "RELEASE_VERSION=${GITHUB_REF_NAME#v}" >> $GITHUB_ENV

      - name: Create Maven settings
        run: |
          mkdir -p $HOME/.m2
          cat > $HOME/.m2/settings.xml << 'EOF'
          <settings>
            <servers>
              <server>
                <id>github</id>
                <username>${env.GITHUB_ACTOR}</username>
                <password>${env.GITHUB_TOKEN}</password>
              </server>
            </servers>
          </settings>
          EOF

      - name: Deploy WebJar to GitHub Packages (Maven)
        run: |
          mvn --batch-mode deploy \
            -Drevision=${{ env.RELEASE_VERSION }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  # ── NuGet ─────────────────────────────────────────────────────────────────
  nuget:
    name: NuGet
    needs: build
    runs-on: ubuntu-latest
    permissions:
      packages: write
      contents: read

    steps:
      - uses: actions/checkout@v4

      - name: Download dist artifact
        uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist/

      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.x'

      - name: Set version from tag
        run: echo "RELEASE_VERSION=${GITHUB_REF_NAME#v}" >> $GITHUB_ENV

      - name: Install NuGet CLI
        run: |
          sudo curl -o /usr/local/bin/nuget.exe https://dist.nuget.org/win-x86-commandline/latest/nuget.exe
          alias nuget="mono /usr/local/bin/nuget.exe"
          echo '#!/bin/bash' | sudo tee /usr/local/bin/nuget
          echo 'mono /usr/local/bin/nuget.exe "$@"' | sudo tee -a /usr/local/bin/nuget
          sudo chmod +x /usr/local/bin/nuget
          sudo apt-get install -y mono-complete 2>/dev/null || true

      - name: Pack and Push NuGet
        run: |
          # Use dotnet pack with a minimal csproj instead of nuget CLI
          mkdir -p nupkg
          cat > /tmp/LombokFuzzer.csproj << EOF
          <Project Sdk="Microsoft.NET.Sdk">
            <PropertyGroup>
              <TargetFramework>netstandard2.0</TargetFramework>
              <PackageId>codinglombok.LombokFuzzer</PackageId>
              <Version>${{ env.RELEASE_VERSION }}</Version>
              <Authors>codinglombok</Authors>
              <Description>Universal fuzzing framework — dist JS content package. Part of the Lombok Ecosystem.</Description>
              <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
              <RepositoryUrl>https://github.com/codinglombok/LombokFuzzer</RepositoryUrl>
              <IncludeBuildOutput>false</IncludeBuildOutput>
            </PropertyGroup>
            <ItemGroup>
              <Content Include="dist/**" Pack="true" PackagePath="content/dist" />
              <Content Include="README.md" Pack="true" PackagePath="content/" />
              <Content Include="LICENSE" Pack="true" PackagePath="content/" />
            </ItemGroup>
          </Project>
          EOF
          cp /tmp/LombokFuzzer.csproj .
          dotnet pack LombokFuzzer.csproj -o nupkg/

      - name: Push to GitHub Packages (NuGet)
        run: |
          dotnet nuget push nupkg/*.nupkg \
            --source "https://nuget.pkg.github.com/codinglombok/index.json" \
            --api-key ${{ secrets.GITHUB_TOKEN }}

  # ── RubyGems ──────────────────────────────────────────────────────────────
  rubygems:
    name: RubyGems
    needs: build
    runs-on: ubuntu-latest
    permissions:
      packages: write
      contents: read

    steps:
      - uses: actions/checkout@v4

      - name: Download dist artifact
        uses: actions/download-artifact@v4
        with:
          name: dist
          path: dist/

      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.3'

      - name: Set version from tag
        run: echo "RELEASE_VERSION=${GITHUB_REF_NAME#v}" >> $GITHUB_ENV

      - name: Build gem
        run: gem build lombok_fuzzer.gemspec

      - name: Push to GitHub Packages (RubyGems)
        run: |
          gem push --key github \
            --host https://rubygems.pkg.github.com/codinglombok \
            lombokfuzzer-${{ env.RELEASE_VERSION }}.gem
        env:
          GEM_HOST_API_KEY: "Bearer ${{ secrets.GITHUB_TOKEN }}"
